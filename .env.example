# URBANOVA Phase 1 configuration. Copy to .env to override. No secrets are needed:
# every provider enabled in this build is credential-free.
URBANOVA_DATA_DIR=./data
URBANOVA_HOST=127.0.0.1
URBANOVA_PORT=8000
URBANOVA_MAX_UPLOAD_MB=25
URBANOVA_SESSION_HOURS=12
# 1 = never call external providers (tests, offline demos). Analyses then report "data unavailable".
URBANOVA_OFFLINE=0
URBANOVA_HTTP_TIMEOUT_S=45
URBANOVA_HTTP_MAX_RETRIES=3
URBANOVA_WORKERS=2
# Basemap tiles. The default OSM volunteer servers are fine for light development/demo use only
# (https://operations.osmfoundation.org/policies/tiles/). Use a commercial provider or your own
# tile server for production, and keep the provider's required attribution.
URBANOVA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
URBANOVA_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
URBANOVA_TILE_MAX_ZOOM=19
