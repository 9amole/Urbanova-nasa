{
  "$defs": {
    "Dataset": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "dataset_type": {
          "title": "Dataset Type",
          "type": "string"
        },
        "data_nature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Nature"
        },
        "approval_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Status"
        },
        "approval_label": {
          "title": "Approval Label",
          "type": "string"
        },
        "terms_confirmed": {
          "title": "Terms Confirmed",
          "type": "boolean"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribution"
        }
      },
      "required": [
        "id",
        "source_id",
        "dataset_type",
        "data_nature",
        "approval_status",
        "approval_label",
        "terms_confirmed",
        "license",
        "attribution"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DesignResult": {
      "properties": {
        "design_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None for a site-only analysis.",
          "title": "Design Id"
        },
        "design_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Design Name"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "baseline",
                "alternative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kind"
        },
        "status": {
          "enum": [
            "succeeded",
            "partially_succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "modules": {
          "additionalProperties": {
            "$ref": "#/$defs/ModuleOutcome"
          },
          "title": "Modules",
          "type": "object"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "title": "Layers",
          "type": "array"
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/ObjectiveAnswer"
          },
          "title": "Objectives",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "hotspots": {
          "description": "Design hotspots, numbered by priority (contract 1.1).",
          "items": {
            "$ref": "#/$defs/Hotspot"
          },
          "title": "Hotspots",
          "type": "array"
        },
        "site_context": {
          "description": "Existing-land context such as the observed hot cluster (contract 1.1).",
          "items": {
            "$ref": "#/$defs/SiteContext"
          },
          "title": "Site Context",
          "type": "array"
        },
        "package": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Site-wide package of best-value options within the budget, re-evaluated together, as a DRAFT design (features) to be approved before it is analysed (contract 1.1).",
          "title": "Package"
        }
      },
      "required": [
        "design_id",
        "design_name",
        "kind",
        "status",
        "modules",
        "metrics",
        "findings",
        "recommendations",
        "layers",
        "objectives",
        "warnings"
      ],
      "title": "DesignResult",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "classification": {
          "enum": [
            "environmental_indicator",
            "potential_environmental_concern",
            "planning_rule_check",
            "data_quality_issue",
            "modelled_outcome"
          ],
          "title": "Classification",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "moderate",
            "low",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "severity_rule": {
          "title": "Severity Rule",
          "type": "string"
        },
        "affected_area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affected Area"
        },
        "geometry": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geometry"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Id"
        },
        "threshold": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Includes status 'provisional_not_approved' for unapproved bands; such findings never exceed 'moderate'.",
          "title": "Threshold"
        },
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        },
        "sources": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Sources",
          "type": "array"
        },
        "confidence": {
          "title": "Confidence",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "hotspot_ids": {
          "description": "Design hotspots this finding is about (contract 1.1).",
          "items": {
            "type": "string"
          },
          "title": "Hotspot Ids",
          "type": "array"
        },
        "checks": {
          "description": "Check-only results (e.g. I7 street orientation) for the hotspot (contract 1.1).",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "category",
        "classification",
        "title",
        "summary",
        "severity",
        "severity_rule",
        "affected_area",
        "geometry",
        "rule_id",
        "threshold",
        "evidence",
        "sources",
        "confidence",
        "limitations"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hotspot": {
      "description": "A place on the drawing with a measured problem, a size, a severity, supporting metrics and likely causes (PHASE2_SPEC §4).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "number": {
          "description": "Priority order: severity, then area.",
          "title": "Number",
          "type": "integer"
        },
        "types": {
          "items": {
            "enum": [
              "H1",
              "H3",
              "H4"
            ],
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        },
        "type_labels": {
          "items": {
            "type": "string"
          },
          "title": "Type Labels",
          "type": "array"
        },
        "condition": {
          "const": "design",
          "title": "Condition",
          "type": "string"
        },
        "site_wide": {
          "description": "True for a site-wide planning shortfall with no polygon.",
          "title": "Site Wide",
          "type": "boolean"
        },
        "geometry": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "WGS 84 GeoJSON geometry; None when site_wide.",
          "title": "Geometry"
        },
        "area_m2": {
          "title": "Area M2",
          "type": "number"
        },
        "site_share_pct": {
          "title": "Site Share Pct",
          "type": "number"
        },
        "size_class": {
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "title": "Size Class",
          "type": "string"
        },
        "intensity": {
          "enum": [
            "high",
            "moderate",
            "low"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "moderate",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "severity_uncapped": {
          "enum": [
            "high",
            "moderate",
            "low"
          ],
          "title": "Severity Uncapped",
          "type": "string"
        },
        "severity_capped": {
          "description": "True when an unapproved project-choice value capped the severity at moderate.",
          "title": "Severity Capped",
          "type": "boolean"
        },
        "provisional_basis": {
          "items": {
            "type": "string"
          },
          "title": "Provisional Basis",
          "type": "array"
        },
        "severity_basis": {
          "title": "Severity Basis",
          "type": "string"
        },
        "supporting_metrics": {
          "items": {
            "$ref": "#/$defs/HotspotEvidence"
          },
          "title": "Supporting Metrics",
          "type": "array"
        },
        "likely_causes": {
          "items": {
            "$ref": "#/$defs/HotspotCause"
          },
          "title": "Likely Causes",
          "type": "array"
        },
        "rule": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "merged_from": {
          "default": 1,
          "title": "Merged From",
          "type": "integer"
        },
        "confidence": {
          "title": "Confidence",
          "type": "string"
        },
        "confidence_reason": {
          "title": "Confidence Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "number",
        "types",
        "type_labels",
        "condition",
        "site_wide",
        "geometry",
        "area_m2",
        "site_share_pct",
        "size_class",
        "intensity",
        "severity",
        "severity_uncapped",
        "severity_capped",
        "provisional_basis",
        "severity_basis",
        "supporting_metrics",
        "likely_causes",
        "confidence",
        "confidence_reason"
      ],
      "title": "Hotspot",
      "type": "object"
    },
    "HotspotCause": {
      "properties": {
        "code": {
          "enum": [
            "LARGE_PAVED_AREA",
            "NO_AFTERNOON_SHADE",
            "NO_TREES_NEARBY",
            "EXPOSED_WEST_EDGE",
            "ORIENTATION_EXPOSES_STREETS",
            "EXCEEDS_RULE"
          ],
          "title": "Code",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "evidence_ids": {
          "description": "Ids of the design metrics supporting the cause.",
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "text",
        "evidence",
        "evidence_ids"
      ],
      "title": "HotspotCause",
      "type": "object"
    },
    "HotspotEvidence": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "source_metric_ids": {
          "description": "Ids of the design metrics this value was derived from.",
          "items": {
            "type": "string"
          },
          "title": "Source Metric Ids",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name",
        "label",
        "value",
        "unit",
        "source_metric_ids"
      ],
      "title": "HotspotEvidence",
      "type": "object"
    },
    "Layer": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "layer_kind": {
          "title": "Layer Kind",
          "type": "string"
        },
        "output_kind": {
          "enum": [
            "observed",
            "reanalysis",
            "calculated",
            "classified",
            "modelled",
            "user_provided"
          ],
          "title": "Output Kind",
          "type": "string"
        },
        "file": {
          "description": "Path relative to the output directory (PNG overlay in Web Mercator, or GeoJSON).",
          "title": "File",
          "type": "string"
        },
        "bounds": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WGS 84 south/west/north/east of a raster overlay.",
          "title": "Bounds"
        },
        "legend": {
          "default": null,
          "title": "Legend"
        },
        "meta": {
          "additionalProperties": true,
          "description": "geotiff: relative path of the analysis-grade GeoTIFF in the local UTM CRS, when produced.",
          "title": "Meta",
          "type": "object"
        }
      },
      "required": [
        "id",
        "module",
        "name",
        "layer_kind",
        "output_kind",
        "file"
      ],
      "title": "Layer",
      "type": "object"
    },
    "Metric": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "state": {
          "description": "Missing values are never 0: a value is present only when state is 'available'.",
          "enum": [
            "available",
            "unknown",
            "unavailable",
            "invalid",
            "blocked",
            "not_applicable"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the value is not available.",
          "title": "Reason"
        },
        "output_kind": {
          "enum": [
            "observed",
            "reanalysis",
            "calculated",
            "classified",
            "modelled",
            "user_provided"
          ],
          "title": "Output Kind",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "design_dependent": {
          "description": "1 when condition is 'design' (kept for contract 1.0 readers).",
          "title": "Design Dependent",
          "type": "integer"
        },
        "condition": {
          "description": "Whether the value describes the existing land (observations of today's site) or the proposed design. Only design values differ between designs.",
          "enum": [
            "existing",
            "design"
          ],
          "title": "Condition",
          "type": "string"
        },
        "source_dataset_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Dataset Ids",
          "type": "array"
        },
        "quality": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "uncertainty": {
          "default": null,
          "title": "Uncertainty"
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra"
        }
      },
      "required": [
        "id",
        "metric_name",
        "label",
        "module",
        "state",
        "value",
        "unit",
        "output_kind",
        "method",
        "design_dependent",
        "condition"
      ],
      "title": "Metric",
      "type": "object"
    },
    "ModuleOutcome": {
      "properties": {
        "status": {
          "enum": [
            "completed",
            "partial",
            "blocked",
            "unavailable",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "title": "Details",
          "type": "object"
        },
        "provider_failures": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Provider Failures",
          "type": "array"
        },
        "shared_across_designs": {
          "default": false,
          "description": "True when this outcome was computed once for the site and reused for this design.",
          "title": "Shared Across Designs",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "label"
      ],
      "title": "ModuleOutcome",
      "type": "object"
    },
    "ObjectiveAnswer": {
      "properties": {
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answerable": {
          "title": "Answerable",
          "type": "boolean"
        },
        "supported_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supported By",
          "type": "array"
        },
        "not_available": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Not Available",
          "type": "array"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        }
      },
      "required": [
        "objective",
        "question",
        "answerable"
      ],
      "title": "ObjectiveAnswer",
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "problem": {
          "title": "Problem",
          "type": "string"
        },
        "intervention": {
          "title": "Intervention",
          "type": "string"
        },
        "expected_direction": {
          "description": "Direction of impact only; never a quantified prediction.",
          "title": "Expected Direction",
          "type": "string"
        },
        "required_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Required Inputs",
          "type": "array"
        },
        "tradeoffs": {
          "items": {
            "type": "string"
          },
          "title": "Tradeoffs",
          "type": "array"
        },
        "evaluation_method": {
          "title": "Evaluation Method",
          "type": "string"
        },
        "target": {
          "additionalProperties": true,
          "title": "Target",
          "type": "object"
        },
        "review_status": {
          "title": "Review Status",
          "type": "string"
        },
        "intervention_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Catalogue intervention (I1–I7) for a measured recommendation (contract 1.1).",
          "title": "Intervention Id"
        },
        "hotspot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
